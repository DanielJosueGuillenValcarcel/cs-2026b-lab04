{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Criterios de aceptación de una historia de usuario de AireMisti",
  "type": "object",
  "required": ["historia_id", "invest_ok", "preguntas", "escenarios"],
  "additionalProperties": false,
  "properties": {
    "historia_id": {"type": "string", "minLength": 1},
    "invest_ok": {"type": "boolean"},
    "preguntas": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "minLength": 5}
    },
    "escenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["titulo", "tipo", "dado", "cuando", "entonces"],
        "additionalProperties": false,
        "properties": {
          "titulo": {"type": "string", "minLength": 3},
          "tipo": {"enum": ["exito", "error", "borde"]},
          "dado": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "cuando": {"type": "string", "minLength": 3},
          "entonces": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
        }
      }
    }
  }
}
