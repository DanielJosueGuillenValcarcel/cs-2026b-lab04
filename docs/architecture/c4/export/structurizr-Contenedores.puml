@startuml
set separator none
title Nivel 2 — Contenedores de AireMisti IoT (400 sensores, Lab 08)

left to right direction

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

AddElementTag("Software System,Externo", $bgColor="#999999", $borderColor="#6b6b6b", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Queue", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Database", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Person", $bgColor="#08427b", $borderColor="#052e56", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Web Browser", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#707070", $lineColor="#707070", $lineStyle = "")

AddBoundaryTag("Software System", $bgColor="#ffffff", $borderColor="#0b4884", $fontColor="#0b4884", $shadowing="", $borderStyle="solid")

Person(Ciudadano, "Ciudadano", $descr="Vecino de Arequipa que consulta la calidad del aire y recibe alertas.", $tags="Person", $link="")
Person(Analistamunicipal, "Analista municipal", $descr="Registra sensores, revisa alertas y descarga el histórico.", $tags="Person", $link="")
System(ReddesensoresPM10PM25, "Red de sensores PM10 / PM2.5", $descr="400 sensores con WiFi/4G y microSD que miden cada minuto y conservan toda lectura no confirmada hasta recibir el acuse. [QA-01]", $tags="Software System,Externo", $link="")
System(TelegramBotAPI, "Telegram Bot API", $descr="Canal público donde se publican las alertas.", $tags="Software System,Externo", $link="")
System(OpenStreetMap, "OpenStreetMap", $descr="Servicio de teselas del mapa base.", $tags="Software System,Externo", $link="")

System_Boundary("AireMistiIoT_boundary", "AireMisti IoT", $tags="Software System") {
  Container(AireMistiIoT.Workerdealertas, "Worker de alertas", $techn="Python 3.12 / Celery (cola alertas)", $descr="Consume solo la cola alertas (picos frescos): evalúa el umbral y publica la alerta. [QA-02]", $tags="Container", $link="")
  Container(AireMistiIoT.Workerhistórico, "Worker histórico", $techn="Python 3.12 / Celery (cola historico)", $descr="Consume la cola historico: avisa al analista de los picos del backlog y revisa los sensores sin señal (RF-07). [QA-02]", $tags="Container", $link="")
  ContainerQueue(AireMistiIoT.BrokerMQTT, "Broker MQTT", $techn="Eclipse Mosquitto 2.0 (QoS 1, cola de 200 000, autosave 60 s, ACL por patrón, TLS)", $descr="Recibe las lecturas, las retiene hasta 8 h si la ingesta no está disponible y solo deja publicar a cada sensor en su propio tema. [QA-03, QA-04, QA-06, QA-08]", $tags="Container,Queue", $link="")
  ContainerDb(AireMistiIoT.Basededatos, "Base de datos", $techn="PostgreSQL 16", $descr="Sensores, lecturas particionadas por mes con clave única (sensor, hora) y alertas; un esquema por módulo. [QA-01, QA-05]", $tags="Container,Database", $link="")
  ContainerDb(AireMistiIoT.Colaycaché, "Cola y caché", $techn="Redis", $descr="Últimas lecturas para el mapa y dos colas de Celery: alertas e historico. [QA-02, QA-07]", $tags="Container,Database", $link="")
  Container(AireMistiIoT.Mapaweb, "Mapa web", $techn="JavaScript + Leaflet", $descr="Mapa en tiempo real para ciudadanos y panel de administración para el analista. [QA-07]", $tags="Container,Web Browser", $link="")
  Container(AireMistiIoT.MonolitoDjango, "Monolito Django", $techn="Python 3.12 / Django + Gunicorn", $descr="Monolito modular: API REST, vistas web y proceso de ingesta suscrito al broker. La ingesta separa los picos frescos de los del backlog y confirma cada lote guardado. [QA-01, QA-02, QA-05]", $tags="Container", $link="")
}

Rel(TelegramBotAPI, Ciudadano, "Notifica las alertas del canal", $techn="", $tags="Relationship", $link="")
Rel(Ciudadano, AireMistiIoT.Mapaweb, "Consulta el mapa", $techn="HTTPS", $tags="Relationship", $link="")
Rel(Analistamunicipal, AireMistiIoT.Mapaweb, "Administra sensores y descarga el histórico", $techn="HTTPS", $tags="Relationship", $link="")
Rel(AireMistiIoT.Mapaweb, AireMistiIoT.MonolitoDjango, "Pide niveles, alertas y CSV", $techn="HTTPS/JSON (REST)", $tags="Relationship", $link="")
Rel(AireMistiIoT.Mapaweb, OpenStreetMap, "Carga las teselas", $techn="HTTPS", $tags="Relationship", $link="")
Rel(ReddesensoresPM10PM25, AireMistiIoT.BrokerMQTT, "Publica lecturas en su tema (QoS 1)", $techn="MQTT/TLS 8883", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango, AireMistiIoT.BrokerMQTT, "Se suscribe a las lecturas (sesión persistente)", $techn="MQTT", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango, AireMistiIoT.Basededatos, "Lee y escribe", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango, AireMistiIoT.BrokerMQTT, "Publica el acuse de cada lote guardado", $techn="MQTT", $tags="Relationship", $link="")
Rel(AireMistiIoT.BrokerMQTT, ReddesensoresPM10PM25, "Entrega el acuse al sensor", $techn="MQTT/TLS 8883", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango, AireMistiIoT.Colaycaché, "Guarda la última lectura y encola los picos en alertas o historico", $techn="Redis protocol", $tags="Relationship", $link="")
Rel(AireMistiIoT.Workerdealertas, AireMistiIoT.Colaycaché, "Consume la cola alertas", $techn="Redis protocol", $tags="Relationship", $link="")
Rel(AireMistiIoT.Workerdealertas, AireMistiIoT.Basededatos, "Registra la alerta del distrito", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(AireMistiIoT.Workerdealertas, TelegramBotAPI, "Publica alertas", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(AireMistiIoT.Workerhistórico, AireMistiIoT.Colaycaché, "Consume la cola historico", $techn="Redis protocol", $tags="Relationship", $link="")
Rel(AireMistiIoT.Workerhistórico, AireMistiIoT.Basededatos, "Lee lecturas y estados de los sensores", $techn="SQL/TCP", $tags="Relationship", $link="")

SHOW_LEGEND(true)
@enduml