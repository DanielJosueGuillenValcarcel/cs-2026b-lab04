@startuml
set separator none
title Nivel 3 — Componentes del Monolito Django

left to right direction

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

AddElementTag("Component", $bgColor="#85bbf0", $borderColor="#5d82a8", $fontColor="#000000", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Queue", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Database", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Web Browser", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#707070", $lineColor="#707070", $lineStyle = "")

AddBoundaryTag("Container", $bgColor="#ffffff", $borderColor="#2e6295", $fontColor="#2e6295", $shadowing="", $borderStyle="solid")

Container(AireMistiIoT.Mapaweb, "Mapa web", $techn="JavaScript + Leaflet", $descr="Mapa en tiempo real para ciudadanos y panel de administración para el analista. [QA-07]", $tags="Container,Web Browser", $link="")
ContainerQueue(AireMistiIoT.BrokerMQTT, "Broker MQTT", $techn="Eclipse Mosquitto 2.0 (QoS 1, cola de 200 000, autosave 60 s, ACL por patrón, TLS)", $descr="Recibe las lecturas, las retiene hasta 8 h si la ingesta no está disponible y solo deja publicar a cada sensor en su propio tema. [QA-03, QA-04, QA-06, QA-08]", $tags="Container,Queue", $link="")
ContainerDb(AireMistiIoT.Basededatos, "Base de datos", $techn="PostgreSQL 16", $descr="Sensores, lecturas particionadas por mes con clave única (sensor, hora) y alertas; un esquema por módulo. [QA-01, QA-05]", $tags="Container,Database", $link="")
ContainerDb(AireMistiIoT.Colaycaché, "Cola y caché", $techn="Redis", $descr="Últimas lecturas para el mapa y dos colas de Celery: alertas e historico. [QA-02, QA-07]", $tags="Container,Database", $link="")

Container_Boundary("AireMistiIoT.MonolitoDjango_boundary", "Monolito Django", $tags="Container") {
  Component(AireMistiIoT.MonolitoDjango.Mapapúblico, "Mapa público", $techn="Django REST Framework", $descr="API de solo lectura con el nivel de cada sensor y las alertas vigentes.", $tags="Component", $link="")
  Component(AireMistiIoT.MonolitoDjango.Ingesta, "Ingesta", $techn="Django app + paho-mqtt", $descr="Se suscribe a airemisti/+/lecturas, guarda cada lote sin duplicados, publica el acuse airemisti/<sensor>/ack y envía solo los picos frescos a la cola alertas. Corre como proceso aparte (manage.py ingesta). [QA-01, QA-02, QA-05]", $tags="Component", $link="")
  Component(AireMistiIoT.MonolitoDjango.Sensores, "Sensores", $techn="Django app", $descr="Registro, ubicación y ciclo de vida de los sensores (ACTIVO, SIN_SENAL, SINCRONIZANDO, MANTENIMIENTO, BAJA).", $tags="Component", $link="")
  Component(AireMistiIoT.MonolitoDjango.Lecturasehistórico, "Lecturas e histórico", $techn="Django app", $descr="Guarda lecturas por lotes con ON CONFLICT DO NOTHING y exporta el histórico en CSV.", $tags="Component", $link="")
  Component(AireMistiIoT.MonolitoDjango.Alertas, "Alertas", $techn="Django app", $descr="Decide si una lectura supera el umbral y gestiona la alerta vigente por distrito; su tarea evaluar() la ejecuta el Worker de alertas. [QA-02]", $tags="Component", $link="")
}

Rel(AireMistiIoT.Mapaweb, AireMistiIoT.MonolitoDjango.Mapapúblico, "Consulta niveles y alertas vigentes", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(AireMistiIoT.Mapaweb, AireMistiIoT.MonolitoDjango.Sensores, "Registra y da de baja sensores", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(AireMistiIoT.Mapaweb, AireMistiIoT.MonolitoDjango.Lecturasehistórico, "Descarga el histórico", $techn="HTTPS/CSV", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango.Ingesta, AireMistiIoT.BrokerMQTT, "Recibe lecturas y publica acuses", $techn="MQTT", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango.Ingesta, AireMistiIoT.MonolitoDjango.Sensores, "Valida el sensor y actualiza su estado", $techn="", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango.Ingesta, AireMistiIoT.MonolitoDjango.Lecturasehistórico, "Guarda el lote sin duplicados", $techn="", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango.Ingesta, AireMistiIoT.MonolitoDjango.Alertas, "Encola evaluar() en la cola alertas (solo picos frescos)", $techn="", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango.Alertas, AireMistiIoT.MonolitoDjango.Lecturasehistórico, "Usa la lectura que superó el umbral", $techn="", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango.Mapapúblico, AireMistiIoT.MonolitoDjango.Sensores, "Lee ubicación y estado", $techn="", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango.Mapapúblico, AireMistiIoT.MonolitoDjango.Lecturasehistórico, "Lee el histórico reciente", $techn="", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango.Mapapúblico, AireMistiIoT.MonolitoDjango.Alertas, "Lee alertas vigentes", $techn="", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango.Sensores, AireMistiIoT.Basededatos, "Lee y escribe", $techn="SQL", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango.Lecturasehistórico, AireMistiIoT.Basededatos, "Inserta por lotes y consulta", $techn="SQL", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango.Alertas, AireMistiIoT.Colaycaché, "Encola la tarea", $techn="Redis protocol", $tags="Relationship", $link="")
Rel(AireMistiIoT.MonolitoDjango.Mapapúblico, AireMistiIoT.Colaycaché, "Lee las últimas lecturas", $techn="Redis protocol", $tags="Relationship", $link="")

SHOW_LEGEND(true)
@enduml